// Hex value example for NanoC

printf("0x01 + 0x02 = 0x%h (expected 0x3)\n", 0x01 + 0x02)
printf("0x03 + 0x04 = 0x%h (expected 0x7)\n", 0x03 + 0x04)
printf("0x05 + 0x06 = 0x%h (expected 0xB)\n", 0x05 + 0x06)
printf("0x07 + 0x08 = 0x%h (expected 0xF)\n", 0x07 + 0x08)
printf("0x09 + 0x0A = 0x%h (expected 0x13)\n", 0x09 + 0x0A)
printf("0x0B + 0x0C = 0x%h (expected 0x17)\n", 0x0B + 0x0C)
printf("0x0D + 0x0E = 0x%h (expected 0x1B)\n", 0x0D + 0x0E)
printf("0x0F + 0x10 = 0x%h (expected 0x1F)\n", 0x0F + 0x10)

end

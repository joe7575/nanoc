{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug nanoc",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/nanoc",
            "args": ["/home/joachim/Projekte/C/_compiler/nanoc/test/test.nc"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
